# MyBTP AI hub used by this app for every SAP call
MYBTPAI_BASE_URL=https://mybtpai.mygoapps.com

# Recommended: an app key from MyBTP AI > Connected Apps (scopes: read:catalog, invoke:gateway)
MYBTPAI_CLIENT_ID=
MYBTPAI_CLIENT_SECRET=

# Alternative: a MyBTP AI user account (leave the app key empty to use this)
MYBTPAI_EMAIL=
MYBTPAI_PASSWORD=
MYBTPAI_APP_NAME=sales-order-viewer

# Signs user session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# Backend port (the Vite dev server proxies /api here)
PORT=8787
